# ---------------------------------------------------------------------
# FRONTEND environment (Vite). Only variables prefixed VITE_ reach the
# browser — never put secrets here.
# Copy to `.env.local` for development, or set these in your host's UI.
# ---------------------------------------------------------------------

# Point the app at the real API. Leave EMPTY to use the embedded provider
# (useful for local UI work with no database running).
VITE_API_URL=

# Explicit mode: "http" (real API) or "local" (embedded demo provider).
VITE_API_MODE=local

# Public URL of the deployed site. Drives canonical URLs, Open Graph tags
# and the sitemap. Change it here, not in components.
VITE_SITE_URL=https://planar.example.com

# Shown in the admin dashboard's system panel.
VITE_APP_VERSION=1.0.0
